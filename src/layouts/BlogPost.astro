---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="ja">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Header />
		<main>
			<article>
				{heroImage && (
					<div class="hero-image">
						<Image width={960} height={480} src={heroImage} alt="" />
					</div>
				)}
				<div class="prose">
					<div class="article-header">
						<div class="date-row">
							<span class="date"><FormattedDate date={pubDate} /></span>
							{updatedDate && (
								<span class="updated">更新: <FormattedDate date={updatedDate} /></span>
							)}
						</div>
						<h1>{title}</h1>
						{description && <p class="description">{description}</p>}
					</div>
					<hr />
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 760px;
		max-width: calc(100% - 2em);
		margin: 0 auto;
		padding: 2.5em 1em;
	}

	.hero-image {
		width: 100%;
		max-width: 760px;
		margin: 0 auto 0;
	}

	.hero-image img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 14px;
		box-shadow: 0 4px 20px rgba(37, 99, 235, 0.12);
	}

	.prose {
		width: 100%;
		margin: 0 auto;
		color: rgb(var(--gray-dark));
	}

	.article-header {
		padding: 2em 0 0;
		margin-bottom: 0;
	}

	.date-row {
		display: flex;
		align-items: center;
		gap: 1em;
		margin-bottom: 0.8em;
	}

	.date {
		font-size: 0.85em;
		color: #94A3B8;
		background-color: #F1F5F9;
		padding: 0.25em 0.7em;
		border-radius: 20px;
	}

	.updated {
		font-size: 0.82em;
		color: #94A3B8;
		font-style: italic;
	}

	.article-header h1 {
		font-size: 1.85em;
		line-height: 1.4;
		color: #1E293B;
		margin: 0 0 0.6em 0;
		border-bottom: none;
	}

	.description {
		font-size: 0.95em;
		color: #64748B;
		background-color: #EFF6FF;
		border-left: 4px solid #BFDBFE;
		padding: 0.8em 1.2em;
		border-radius: 0 8px 8px 0;
		margin: 0;
		line-height: 1.7;
	}

	hr {
		margin: 2em 0;
	}

	/* 記事本文のスタイル調整 */
	.prose :global(h2) {
		font-size: 1.4em;
		margin-top: 2.2em;
	}

	.prose :global(h3) {
		font-size: 1.15em;
		margin-top: 1.8em;
	}

	.prose :global(em) {
		color: #64748B;
	}

	.prose :global(table) {
		margin: 1.5em 0;
	}

	.prose :global(blockquote) {
		margin: 1.5em 0;
	}

	@media (max-width: 720px) {
		main {
			padding: 1.5em 1em;
		}

		.article-header h1 {
			font-size: 1.45em;
		}

		.hero-image img {
			border-radius: 10px;
		}
	}
</style>
