---
import HeaderLink from './HeaderLink.astro';
---

<header>
	<div class="header-inner">
		<div class="brand">
			<a href="/" class="site-title">配当日和</a>
			<p class="site-subtitle">お金も私も働く、公務員の小さな自由計画</p>
		</div>
		<nav>
			<HeaderLink href="/">ホーム</HeaderLink>
			<HeaderLink href="/blog">記事一覧</HeaderLink>
			<HeaderLink href="/about">このブログについて</HeaderLink>
		</nav>
	</div>
</header>

<style>
	header {
		background-color: #FFFFFF;
		border-bottom: 3px solid #DBEAFE;
		position: sticky;
		top: 0;
		z-index: 100;
		box-shadow: 0 2px 8px rgba(37, 99, 235, 0.08);
	}

	.header-inner {
		max-width: 960px;
		margin: 0 auto;
		padding: 0.9em 1.5em;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1em;
	}

	.brand {
		display: flex;
		flex-direction: column;
		gap: 0.1em;
	}

	.site-title {
		font-size: 1.6em;
		font-weight: 800;
		color: #1D4ED8;
		text-decoration: none;
		letter-spacing: 0.02em;
		line-height: 1;
	}

	.site-title:hover {
		color: #2563EB;
		text-decoration: none;
	}

	.site-subtitle {
		font-size: 0.72em;
		color: #64748B;
		margin: 0;
		line-height: 1;
		letter-spacing: 0.01em;
	}

	nav {
		display: flex;
		align-items: center;
		gap: 0.2em;
	}

	nav :global(a) {
		padding: 0.45em 0.85em;
		color: #475569;
		text-decoration: none;
		border-radius: 6px;
		font-size: 0.92em;
		font-weight: 500;
		transition: background-color 0.15s, color 0.15s;
		white-space: nowrap;
	}

	nav :global(a:hover) {
		background-color: #EFF6FF;
		color: #2563EB;
		text-decoration: none;
	}

	nav :global(a.active) {
		background-color: #DBEAFE;
		color: #1D4ED8;
		font-weight: 700;
	}

	@media (max-width: 640px) {
		.header-inner {
			flex-direction: column;
			align-items: flex-start;
			padding: 0.8em 1em;
			gap: 0.6em;
		}

		nav {
			gap: 0.1em;
		}

		nav :global(a) {
			padding: 0.4em 0.65em;
			font-size: 0.88em;
		}

		.site-title {
			font-size: 1.35em;
		}
	}
</style>
