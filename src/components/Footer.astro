---
const today = new Date();
---

<footer>
	<div class="footer-inner">
		<p class="footer-title">配当日和</p>
		<p class="footer-sub">お金も私も働く、公務員の小さな自由計画</p>
		<p class="footer-copy">&copy; {today.getFullYear()} 配当日和. All rights reserved.</p>
	</div>
</footer>

<style>
	footer {
		background-color: #1E293B;
		color: #94A3B8;
		margin-top: 4em;
	}

	.footer-inner {
		max-width: 960px;
		margin: 0 auto;
		padding: 2.5em 1.5em;
		text-align: center;
	}

	.footer-title {
		font-size: 1.1em;
		font-weight: 700;
		color: #E2E8F0;
		margin: 0 0 0.3em 0;
		letter-spacing: 0.05em;
	}

	.footer-sub {
		font-size: 0.82em;
		color: #64748B;
		margin: 0 0 1.2em 0;
	}

	.footer-copy {
		font-size: 0.8em;
		color: #475569;
		margin: 0;
	}
</style>
