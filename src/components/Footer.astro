---
const today = new Date();
---

<footer>
	<div class="footer-inner">
		<p class="footer-title">配当日和</p>
		<p class="footer-sub">配当金で、暮らしにすこし余白を</p>
		<nav class="footer-nav">
			<a href="/privacy-policy">プライバシーポリシー</a>
		</nav>
		<p class="footer-copy">&copy; {today.getFullYear()} 配当日和. All rights reserved.</p>
	</div>
</footer>

<style>
	footer {
		background-color: #2C1A12;
		color: #A89080;
		margin-top: 4em;
	}

	.footer-inner {
		max-width: 960px;
		margin: 0 auto;
		padding: 2.5em 1.5em;
		text-align: center;
	}

	.footer-title {
		font-size: 1.1em;
		font-weight: 700;
		color: #F5EDE8;
		margin: 0 0 0.3em 0;
		letter-spacing: 0.05em;
	}

	.footer-sub {
		font-size: 0.82em;
		color: #9C8B7A;
		margin: 0 0 1.2em 0;
	}

	.footer-nav {
		margin-bottom: 1em;
	}

	.footer-nav a {
		font-size: 0.82em;
		color: #9C8B7A;
		text-decoration: none;
		transition: color 0.2s;
	}

	.footer-nav a:hover {
		color: #C0714F;
		text-decoration: underline;
	}

	.footer-copy {
		font-size: 0.8em;
		color: #7A6558;
		margin: 0;
	}
</style>
