---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import OgSiteImage from '../assets/og-site.png';
import HeroMain from '../assets/hero-main.jpg';
import HeroSub from '../assets/hero-sub.jpg';

const allPosts = (await getCollection('blog'))
	.filter(p => !['first-post', 'second-post', 'third-post', 'markdown-style-guide', 'using-mdx'].includes(p.id));

const sortedPosts = [...allPosts].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// 人気記事ランキング（最新5件で代用）
const popularPosts = sortedPosts.slice(0, 5);

// 最新記事（3件）
const latestPosts = sortedPosts.slice(0, 3);

// カテゴリ
const countByCategory = (cat: string) => allPosts.filter(p => p.data.category === cat).length;
const categories = [
	{ name: '高配当株・配当投資', slug: 'dividend', emoji: '📈' },
	{ name: '投資の始め方',       slug: 'start',    emoji: '🌱' },
	{ name: 'お金の管理',         slug: 'money',    emoji: '💰' },
	{ name: '投資マインド・公務員', slug: 'mindset', emoji: '🧠' },
];
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} image={OgSiteImage} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	</head>
	<body>
		<Header />

		<main class="home-main">
			<!-- 装飾グラデ背景 -->
			<div class="page-bg">
				<div class="deco-circle deco-tr" aria-hidden="true"></div>
				<div class="deco-circle deco-ml" aria-hidden="true"></div>

				<!-- ── HERO ─────────────────────────────────────── -->
				<section class="section hero-section">
					<div class="container hero-grid">
						<!-- 左：テキスト -->
						<div class="hero-text">
							<div class="hero-kicker">
								<span class="kicker-dot"></span>
								<span>公務員のゆるFIRE日記</span>
							</div>

							<h1 class="hero-h1">
								配当金で、<br>
								毎日にもう一つの<br>
								<span class="accent-word">楽しみ</span>を。
							</h1>

							<p class="hero-body">
								40代公務員が、高配当株・インデックス・iDeCoをコツコツと。お金にも働いてもらいながら、旅も、おいしいごはんも、自分の時間も楽しむ等身大の暮らしの記録です。
							</p>

							<div class="hero-ctas">
								<a href="#latest" class="btn-primary">最新の記事を読む →</a>
								<a href="/about" class="btn-text">このブログについて</a>
							</div>

							<!-- 実績ストリップ -->
							<div class="stats-strip">
								<div class="stat-item">
									<div class="stat-num">約90<span class="stat-unit">万円</span></div>
									<div class="stat-label">年間配当</div>
								</div>
								<div class="stat-divider"></div>
								<div class="stat-item">
									<div class="stat-num">100<span class="stat-unit">銘柄超</span></div>
									<div class="stat-label">保有銘柄</div>
								</div>
								<div class="stat-divider"></div>
								<div class="stat-item">
									<div class="stat-num">約10<span class="stat-unit">年</span></div>
									<div class="stat-label">投資歴</div>
								</div>
							</div>
						</div>

						<!-- 右：写真コラージュ -->
						<div class="hero-collage">
							<div class="badge-float" aria-hidden="true">和</div>
							<div class="collage-main">
								<Image
									src={HeroMain}
									alt="暮らしのメイン写真"
									width={330}
									height={430}
									style="width:100%;height:100%;object-fit:cover;border-radius:26px;"
								/>
							</div>
							<div class="collage-sub">
								<Image
									src={HeroSub}
									alt="暮らしのサブ写真"
									width={240}
									height={230}
									style="width:100%;height:100%;object-fit:cover;border-radius:16px;"
								/>
							</div>
						</div>
					</div>
				</section>

				<!-- ── 人気記事ランキング ─────────────────────── -->
				<section class="section rank-section">
					<div class="container">
						<div class="section-header">
							<div>
								<div class="section-kicker">POPULAR</div>
								<h2 class="section-h2">いま読まれている記事</h2>
							</div>
							<a href="/blog" class="see-all-link">すべて見る →</a>
						</div>

						<div class="rank-grid">
							{popularPosts.map((post, i) => (
								<a href={`/blog/${post.data.slug ?? post.id}/`} class="rank-card">
									<span class={`rank-num ${i < 2 ? 'rank-top' : 'rank-mid'}`}>{i + 1}</span>
									<div class="rank-thumb">
										{post.data.heroImage
											? <img src={post.data.heroImage.src} alt={post.data.title} />
											: <div class="rank-thumb-placeholder"></div>
										}
									</div>
									<div class="rank-info">
										<div class="rank-cat">{post.data.category ?? '高配当株・配当投資'}</div>
										<div class="rank-title">{post.data.title}</div>
									</div>
								</a>
							))}
						</div>
					</div>
				</section>

				<!-- ── カテゴリ ───────────────────────────────── -->
				<section class="section cat-section">
					<div class="container">
						<div class="section-header-simple">
							<div class="section-kicker">CATEGORY</div>
							<h2 class="section-h2">カテゴリから探す</h2>
						</div>

						<div class="cat-grid">
							{categories.map((cat) => (
								<a href={`/category/${cat.slug}/`} class="cat-card">
									<span class="cat-icon">{cat.emoji}</span>
									<div class="cat-name">{cat.name}</div>
									<div class="cat-count">{countByCategory(cat.name)}記事</div>
								</a>
							))}
						</div>
					</div>
				</section>

				<!-- ── 最新記事 ───────────────────────────────── -->
				<section id="latest" class="section latest-section">
					<div class="container">
						<div class="section-header">
							<div>
								<div class="section-kicker">LATEST</div>
								<h2 class="section-h2">最新の記事</h2>
							</div>
							<a href="/blog" class="see-all-link">記事一覧へ →</a>
						</div>

						<div class="latest-grid">
							{latestPosts.map((post) => (
								<a href={`/blog/${post.data.slug ?? post.id}/`} class="latest-card">
									<div class="latest-img">
										{post.data.heroImage
											? <img src={post.data.heroImage.src} alt={post.data.title} />
											: <div class="latest-img-placeholder"></div>
										}
									</div>
									<div class="latest-body">
										<div class="latest-meta">
											<span class="latest-badge">{post.data.category ?? '高配当株・配当投資'}</span>
											<span class="latest-date">
												<FormattedDate date={post.data.pubDate} />
											</span>
										</div>
										<div class="latest-title">{post.data.title}</div>
										{post.data.description && (
											<p class="latest-desc">{post.data.description}</p>
										)}
									</div>
								</a>
							))}
						</div>
					</div>
				</section>
			</div><!-- /.page-bg -->
		</main>

		<Footer />
	</body>
</html>

<style>
	/* ── main幅のリセット ─────────────────────────────── */
	:global(main.home-main) {
		width: 100%;
		max-width: 100%;
		margin: 0;
		padding: 0;
	}

	/* ── 背景グラデーション ─────────────────────────────── */
	.page-bg {
		position: relative;
		min-height: 100vh;
		background:
			radial-gradient(1200px 700px at 85% -5%, #f4e2d4 0%, rgba(248,239,225,0) 60%),
			linear-gradient(180deg, #fbf4e8 0%, #f8efe1 100%);
		overflow: hidden;
	}

	/* 装飾円 */
	.deco-circle {
		position: absolute;
		border-radius: 50%;
		pointer-events: none;
	}
	.deco-tr {
		top: -120px; right: -80px;
		width: 380px; height: 380px;
		background: radial-gradient(circle at 35% 35%, #f4e2d4, rgba(248,239,225,0));
	}
	.deco-ml {
		top: 520px; left: -90px;
		width: 260px; height: 260px;
		background: radial-gradient(circle at 50% 50%, rgba(199,149,75,0.18), rgba(248,239,225,0));
	}

	/* ── コンテナ ─────────────────────────────────────── */
	.container {
		max-width: 1120px;
		margin: 0 auto;
		padding: 0 40px;
	}

	/* ── セクション共通 ───────────────────────────────── */
	.section {
		position: relative;
		z-index: 2;
	}

	.section-kicker {
		font-size: 13px;
		font-weight: 700;
		color: #c2683f;
		letter-spacing: 2px;
		margin-bottom: 8px;
	}

	.section-h2 {
		font-family: 'Shippori Mincho B1', 'Shippori Mincho', serif;
		font-weight: 800;
		font-size: 34px;
		margin: 0;
		color: #2f2117;
		border-bottom: none;
		padding-bottom: 0;
	}

	.section-header {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		margin-bottom: 30px;
	}

	.section-header-simple {
		margin-bottom: 26px;
	}

	.see-all-link {
		font-size: 14px;
		font-weight: 700;
		color: #8a7258;
		text-decoration: none;
		white-space: nowrap;
		transition: color 0.2s;
	}
	.see-all-link:hover {
		color: #c2683f;
		text-decoration: none;
	}

	/* ── HERO ─────────────────────────────────────────── */
	.hero-section {
		padding: 34px 0 70px;
	}

	.hero-grid {
		display: grid;
		grid-template-columns: 1.04fr 0.96fr;
		gap: 56px;
		align-items: center;
	}

	/* キッカーピル */
	.hero-kicker {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		background: #fff7ee;
		border: 1px solid #efddc6;
		padding: 7px 15px;
		border-radius: 999px;
		margin-bottom: 24px;
		white-space: nowrap;
		box-shadow: 0 3px 12px rgba(150,100,50,0.06);
		font-size: 13px;
		font-weight: 700;
		color: #a9512f;
		letter-spacing: 0.5px;
	}
	.kicker-dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: #c2683f;
		flex-shrink: 0;
	}

	/* H1 */
	.hero-h1 {
		font-family: 'Shippori Mincho B1', 'Shippori Mincho', serif;
		font-weight: 800;
		font-size: 58px;
		line-height: 1.28;
		letter-spacing: 1px;
		margin: 0 0 24px;
		color: #2f2117;
		border-bottom: none;
		padding-bottom: 0;
	}
	.accent-word { color: #c2683f; }

	/* 本文 */
	.hero-body {
		font-size: 16px;
		line-height: 2;
		color: #6a5848;
		margin: 0 0 30px;
		max-width: 480px;
	}

	/* CTAボタン群 */
	.hero-ctas {
		display: flex;
		align-items: center;
		gap: 14px;
		margin-bottom: 34px;
	}

	.btn-primary {
		display: inline-flex;
		align-items: center;
		background: #c2683f;
		color: #fff;
		font-size: 15.5px;
		font-weight: 700;
		text-decoration: none;
		padding: 15px 28px;
		border-radius: 999px;
		box-shadow: 0 10px 24px rgba(194,104,63,0.32);
		transition: background 0.2s, transform 0.2s;
	}
	.btn-primary:hover {
		background: #a9512f;
		transform: translateY(-2px);
		text-decoration: none;
		color: #fff;
	}

	.btn-text {
		display: inline-flex;
		align-items: center;
		font-size: 15px;
		font-weight: 700;
		text-decoration: none;
		color: #5b4a3a;
		padding: 15px 6px;
		border-bottom: 2px solid #e7d4bc;
		transition: color 0.2s, border-color 0.2s;
	}
	.btn-text:hover {
		color: #c2683f;
		border-color: #c2683f;
		text-decoration: none;
	}

	/* 実績ストリップ */
	.stats-strip {
		display: flex;
		align-items: center;
		gap: 26px;
		padding-top: 24px;
		border-top: 1px dashed #e3d0b8;
	}
	.stat-item { }
	.stat-num {
		font-family: 'Shippori Mincho B1', 'Shippori Mincho', serif;
		font-weight: 700;
		font-size: 23px;
		color: #33251a;
	}
	.stat-unit { font-size: 14px; }
	.stat-label {
		font-size: 12px;
		color: #9a8266;
		margin-top: 2px;
	}
	.stat-divider {
		width: 1px;
		height: 34px;
		background: #e3d0b8;
		flex-shrink: 0;
	}

	/* 写真コラージュ */
	.hero-collage {
		position: relative;
		height: 480px;
	}

	.collage-main {
		position: absolute;
		top: 0; left: 0;
		width: 330px; height: 430px;
		border-radius: 26px;
		overflow: hidden;
		box-shadow: 0 26px 50px rgba(120,80,40,0.18);
	}

	.collage-sub {
		position: absolute;
		bottom: 6px; right: 0;
		width: 240px; height: 230px;
		border-radius: 22px;
		overflow: hidden;
		border: 6px solid #fbf4e8;
		box-shadow: 0 20px 40px rgba(120,80,40,0.16);
	}

	@keyframes floaty {
		0%, 100% { transform: translateY(0); }
		50% { transform: translateY(-14px); }
	}

	.badge-float {
		position: absolute;
		top: 14px; right: 24px;
		z-index: 3;
		width: 96px; height: 96px;
		border-radius: 50%;
		background: linear-gradient(135deg, #c2683f, #e0a45c);
		box-shadow: 0 12px 30px rgba(194,104,63,0.3);
		animation: floaty 6s ease-in-out infinite;
		display: flex;
		align-items: center;
		justify-content: center;
		color: #fff;
		font-family: 'Shippori Mincho B1', 'Shippori Mincho', serif;
		font-size: 30px;
	}

	/* ── 人気記事ランキング ─────────────────────────────── */
	.rank-section {
		padding: 18px 0 30px;
	}

	.rank-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 18px 36px;
	}

	.rank-card {
		display: flex;
		gap: 18px;
		align-items: center;
		text-decoration: none;
		padding: 14px;
		border-radius: 18px;
		background: #fffdf9;
		border: 1px solid #f0e3d1;
		box-shadow: 0 6px 18px rgba(120,80,40,0.05);
		transition: transform 0.2s, box-shadow 0.2s;
	}
	.rank-card:hover {
		transform: translateY(-3px);
		box-shadow: 0 14px 30px rgba(120,80,40,0.12);
		text-decoration: none;
	}

	.rank-num {
		font-family: 'Shippori Mincho B1', 'Shippori Mincho', serif;
		font-weight: 800;
		font-size: 42px;
		line-height: 1;
		min-width: 38px;
		text-align: center;
		flex-shrink: 0;
	}
	.rank-top { color: #c2683f; }
	.rank-mid { color: #cdb085; }

	.rank-thumb {
		width: 78px; height: 78px;
		border-radius: 12px;
		overflow: hidden;
		flex-shrink: 0;
	}
	.rank-thumb img {
		width: 100%; height: 100%;
		object-fit: cover;
		border-radius: 12px;
	}
	.rank-thumb-placeholder {
		width: 100%; height: 100%;
		background: #f0e3d1;
		border-radius: 12px;
	}

	.rank-info { min-width: 0; }
	.rank-cat {
		font-size: 11.5px;
		font-weight: 700;
		color: #a9512f;
		margin-bottom: 6px;
	}
	.rank-title {
		font-size: 15px;
		font-weight: 700;
		line-height: 1.55;
		color: #33251a;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	/* ── カテゴリ ─────────────────────────────────────── */
	.cat-section {
		padding: 46px 0 30px;
	}

	.cat-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 18px;
	}

	.cat-card {
		text-decoration: none;
		background: linear-gradient(160deg, #fffdf9, #fdf3e6);
		border: 1px solid #f0e3d1;
		border-radius: 20px;
		padding: 26px 22px;
		display: flex;
		flex-direction: column;
		gap: 14px;
		box-shadow: 0 6px 18px rgba(120,80,40,0.05);
		transition: transform 0.2s, box-shadow 0.2s;
	}
	.cat-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 16px 32px rgba(120,80,40,0.12);
		text-decoration: none;
	}

	.cat-icon {
		width: 48px; height: 48px;
		border-radius: 14px;
		background: #f4e2d4;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 24px;
	}

	.cat-name {
		font-family: 'Shippori Mincho B1', 'Shippori Mincho', serif;
		font-weight: 700;
		font-size: 17px;
		color: #33251a;
		line-height: 1.5;
	}

	.cat-count {
		font-size: 13px;
		color: #9a8266;
	}

	/* ── 最新記事 ─────────────────────────────────────── */
	.latest-section {
		padding: 46px 0 80px;
	}

	.latest-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 28px;
	}

	.latest-card {
		text-decoration: none;
		background: #fffdf9;
		border: 1px solid #f0e3d1;
		border-radius: 20px;
		overflow: hidden;
		box-shadow: 0 6px 18px rgba(120,80,40,0.05);
		display: flex;
		flex-direction: column;
		transition: transform 0.2s, box-shadow 0.2s;
	}
	.latest-card:hover {
		transform: translateY(-5px);
		box-shadow: 0 18px 36px rgba(120,80,40,0.13);
		text-decoration: none;
	}

	.latest-img {
		width: 100%; height: 180px;
		overflow: hidden;
		flex-shrink: 0;
	}
	.latest-img img {
		width: 100%; height: 100%;
		object-fit: cover;
		border-radius: 0;
	}
	.latest-img-placeholder {
		width: 100%; height: 100%;
		background: #f0e3d1;
	}

	.latest-body {
		padding: 20px 20px 24px;
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.latest-meta {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.latest-badge {
		font-size: 11.5px;
		font-weight: 700;
		color: #fff;
		background: #c2683f;
		padding: 3px 10px;
		border-radius: 999px;
		white-space: nowrap;
	}

	.latest-date {
		font-size: 12px;
		color: #a8957f;
	}

	.latest-title {
		font-family: 'Shippori Mincho B1', 'Shippori Mincho', serif;
		font-weight: 700;
		font-size: 18px;
		line-height: 1.6;
		color: #33251a;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.latest-desc {
		font-size: 13.5px;
		line-height: 1.8;
		color: #7a6553;
		margin: 0;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	/* ── レスポンシブ ─────────────────────────────────── */
	@media (max-width: 1024px) {
		.hero-h1 { font-size: 46px; }
	}

	@media (max-width: 900px) {
		.container { padding: 0 24px; }

		.hero-grid {
			grid-template-columns: 1fr;
			gap: 40px;
		}
		.hero-collage {
			height: 320px;
		}
		.collage-main {
			width: 220px; height: 286px;
		}
		.collage-sub {
			width: 160px; height: 154px;
		}
		.badge-float {
			width: 72px; height: 72px;
			font-size: 22px;
		}

		.rank-grid { grid-template-columns: 1fr; }

		.cat-grid { grid-template-columns: repeat(2, 1fr); }

		.latest-grid { grid-template-columns: repeat(2, 1fr); }
	}

	@media (max-width: 640px) {
		.container { padding: 0 16px; }

		.hero-section { padding: 24px 0 48px; }
		.hero-h1 { font-size: 34px; }
